{
  "manifest_version": 3,
  "name": "Tolmach",
  "version": "0.1.0",
  "description": "Translate selected text from the right-click menu.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
